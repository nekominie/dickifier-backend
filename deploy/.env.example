# Public origin used for CORS, Origin/Sec-Fetch-Site validation, and healthchecks
DICKIFIER_PUBLIC_ORIGIN=https://dickifier.nekomisystems.com

# Path to the sibling nekomisystems repository (relative to deploy/ or absolute)
NEKOMISYSTEMS_DIR=../../nekomisystems

# Secret files must be created under ./secrets/ (never committed to git):
# - ./secrets/postgres_super_password.txt
# - ./secrets/postgres_migrator_password.txt
# - ./secrets/postgres_app_password.txt
# - ./secrets/db_migrator_connection.txt   (Host=db;Port=5432;Database=dickifier;Username=dickifier_migrator;Password=<migrator_pass>)
# - ./secrets/db_app_connection.txt        (Host=db;Port=5432;Database=dickifier;Username=dickifier_app;Password=<app_pass>)
# - ./secrets/jwt_secret_key.txt           (>= 64 random chars, no trailing newline)
# - ./secrets/security_fingerprint_key.txt (>= 32 random chars, distinct from jwt_secret_key, no trailing newline)
